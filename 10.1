""" Roll D6 """

import tkinter as tk
import random

# Główna funkcja losująca
def roll(a):    
    a = str(random.randint(1, 6))
    a_label.config(text=f"{a}")


root = tk.Tk()
root.title("Rzut kością")
root.geometry("350x300")

title = tk.Label(root, text="Spróbuj szczęścia!", font=("Arial", 16))  # Napis witający
title.pack(pady=10)

button_frame = tk.Frame(root)
button_frame.pack(pady=10)

a = 1

roll_button  = tk.Button(button_frame, text="Rzuć kością", width=15, command=lambda: roll(a))  # Przycisk do losowania
roll_button.grid(row=0, column=0, padx=5)

a_label = tk.Label(root, text=f"{a}", font=("Arial", 50), justify="center")
a_label.pack(pady=40)

root.mainloop()
