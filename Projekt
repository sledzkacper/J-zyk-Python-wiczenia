"""
=============================================================
Projekt Python - Wielomiany

Wielomiany gęste na bazie list Pythona. Należy zaimplementować następujące działania na wielomianach: dodawanie, odejmowanie, 
mnożenie, obliczanie wartości (Horner), porównywanie (==,!=), wyświetlanie, użycie nawiasów [] (odczyt współczynnika przy danej 
potędze x). Wielomiany są równe, gdy ich różnica jest wielomianem zerowym. Przydatne funkcje: is_zero(), degree() (stopień wielomianu).
=============================================================
"""

import unittest
import math
import numpy as np

class Wielomian:

    
    def __init__(self, a):

        if not isinstance(a, list):
            raise TypeError("Współczynniki muszą być w formie listy")

        for c in a:

            if not isinstance(c, (int, float, np.integer, np.floating)):
                raise ValueError("Współczynnikiem musi być liczba wymierna")
            
            # if c == 0:
            #     raise ValueError("Współczynniki muszą być niezerowe")
            

                
            
    
        self.size = len(a) - 1   # n to lista, n - 1 daje stopień wielomianu
        self.a = a

                    

    def __str__(self):
        return f"{self.a}"
    
    

    def __add__(self, other):
        
        # kopiujemy listy, żeby nie psuć oryginałów
        a1 = self.a[:]
        a2 = other.a[:]
        
        if len(a1) > len(a2):
            różnica_stopnia = len(a1) - len(a2)
            a2.extend([0] * różnica_stopnia)
        elif len(a1) < len(a2):
            różnica_stopnia = len(a2) - len(a1)
            a1.extend(różnica_stopnia * [0])
        

        stopień = max(len(a1), len(a2))
        s = [1] * stopień

        suma = Wielomian(s)

        for i in range(len((s))):
            s[i] = round(a1[i] + a2[i], 3)

        return suma
    
    def __sub__(self, other):
        
        # kopiujemy listy, żeby nie psuć oryginałów
        a1 = self.a[:]
        a2 = other.a[:]
        
        if len(a1) > len(a2):
            różnica_stopnia = len(a1) - len(a2)
            a2.extend([0] * różnica_stopnia)
        elif len(a1) < len(a2):
            różnica_stopnia = len(a2) - len(a1)
            a1.extend(różnica_stopnia * [0])
        

        stopień = max(len(a1), len(a2))
        s = [1] * stopień

        suma = Wielomian(s)

        for i in range(len((s))):
            s[i] = round(a1[i] - a2[i], 3)

        return suma

    def __mul__(self, other):
        a1 = self.a[:]
        a2 = other.a[:]


        
        macierz = np.zeros((0, len(a2)))


        for i in range(len(a1)):

            L = [1] * len(a2)

            for j in range(len(a2)):
                L[j] = a1[i] * a2[j]            # Pętla wymnaża po kolei wszystkie składniki z wielomianów
            macierz = np.vstack([macierz, L])   # Następnie tworzy macierz gdzie umiejscawia wyniki z mnożenia

        

        stopień = len(a1) + len(a2) - 1 # Stopień nowego wielomianu jest równy sumie stopni tych wielomianów
        s = [0] * stopień


        for k in range(stopień):
            suma = 0
            for i in range(len(a1)):
                j = k - i

                if 0 <= j < len(a2):
                    suma += macierz[i][j]

            s[k] = round(float(suma), 3)

        return Wielomian(s)


        

    def _normalize(self):
        # usuwa zera z końca listy
        while len(self.a) > 1 and abs(self.a[-1]) == 0:
            self.a.pop()
        self.size = len(self.a) - 1


    

    def degree(self):
        self._normalize()
        return self.size



    def is_zero(self):
        self._normalize()
        return len(self.a) == 1 and self.a[0] == 0



    def __getitem__(self, index):
        if not isinstance(index, int):
            raise TypeError("Indeks musi być liczbą całkowitą")

        if index < 0:
            raise IndexError("Potęga nie może być ujemna")

        if index >= len(self.a):
            return 0

        return self.a[index]




    def __call__(self, x):
        if not isinstance(x, (int, float, np.integer, np.floating)):
            raise TypeError("Argument musi być liczbą")

        wynik = 0
        for coef in reversed(self.a):               # x(x(xa3​+a2​)+a1​)+a0​ zamiast kalsycznego a3​x^3 + a2​x^2 + a1​x +a0​
            wynik = wynik * x + coef

        return round(float(wynik), 6)




    def __eq__(self, other):
        if not isinstance(other, Wielomian):
            return False

        self._normalize()
        other._normalize()

        return self.a == other.a


    def __ne__(self, other):
        return not self.__eq__(other)



    def __str__(self):
        self._normalize()

        if self.is_zero():      # Pomijamy zera
            return "0"

        wyrazy = []

        for i in range(len(self.a) - 1, -1, -1):
            coef = self.a[i]

            if coef == 0:
                continue

            if i == 0:
                wyrazy.append(f"{coef}")
            elif i == 1:
                if coef == 1:
                    wyrazy.append("x")
                elif coef == -1:
                    wyrazy.append("-x")
                else:
                    wyrazy.append(f"{coef}x")
            else:
                if coef == 1:
                    wyrazy.append(f"x^{i}")
                elif coef == -1:
                    wyrazy.append(f"-x^{i}")
                else:
                    wyrazy.append(f"{coef}x^{i}")

        return " + ".join(wyrazy).replace("+ -", "- ")

        



        




