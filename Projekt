""" Testy """

class TestWielomian(unittest.TestCase):


    def test_init_valid(self):
        w = Wielomian([1, 2, 3])
        self.assertEqual(w.a, [1, 2, 3])

    def test_init_invalid_type(self):
        with self.assertRaises(TypeError):
            Wielomian("123")

    def test_init_invalid_element(self):
        with self.assertRaises(ValueError):
            Wielomian([1, "x", 3])



    def test_add(self):
        w1 = Wielomian([1, 2])
        w2 = Wielomian([3, 4])
        wynik = w1 + w2
        self.assertEqual(wynik, Wielomian([4, 6]))



    def test_sub(self):
        w1 = Wielomian([5, 4])
        w2 = Wielomian([3, 2])
        wynik = w1 - w2
        self.assertEqual(wynik, Wielomian([2, 2]))



    def test_mul(self):
        w1 = Wielomian([1, 1])       # 1 + x
        w2 = Wielomian([1, 1])       # 1 + x
        wynik = w1 * w2              # (1+x)^2 = 1 + 2x + x^2
        self.assertEqual(wynik, Wielomian([1, 2, 1]))


    def test_degree(self):
        w = Wielomian([1, 2, 0, 0])
        self.assertEqual(w.degree(), 1)



    def test_is_zero(self):
        w = Wielomian([0, 0, 0])
        self.assertTrue(w.is_zero())

        w2 = Wielomian([1, 0])
        self.assertFalse(w2.is_zero())


    def test_getitem(self):
        w = Wielomian([1, 2, 3])
        self.assertEqual(w[0], 1)
        self.assertEqual(w[2], 3)
        self.assertEqual(w[5], 0)

    def test_getitem_invalid(self):
        w = Wielomian([1, 2])
        with self.assertRaises(TypeError):
            _ = w["x"]

        with self.assertRaises(IndexError):
            _ = w[-1]


    def test_call(self):
        w = Wielomian([1, 2, 3])  
        self.assertEqual(w(0), 1)
        self.assertEqual(w(1), 6)
        self.assertEqual(w(2), 17)


    def test_eq(self):
        w1 = Wielomian([1, 2, 0])
        w2 = Wielomian([1, 2])
        self.assertTrue(w1 == w2)

    def test_ne(self):
        w1 = Wielomian([1, 2])
        w2 = Wielomian([2, 1])
        self.assertTrue(w1 != w2)


    def test_str(self):
        w = Wielomian([1, 2, 4])
        self.assertEqual(str(w), "4x^2 + 2x + 1")

        w2 = Wielomian([0])
        self.assertEqual(str(w2), "0")



if __name__ == "__main__":
    unittest.main()


