"""
=============================================================
Projekt Python - Wielomiany

Wielomiany gęste na bazie list Pythona. Należy zaimplementować następujące działania na wielomianach: dodawanie, odejmowanie, 
mnożenie, obliczanie wartości (Horner), porównywanie (==,!=), wyświetlanie, użycie nawiasów [] (odczyt współczynnika przy danej 
potędze x). Wielomiany są równe, gdy ich różnica jest wielomianem zerowym. Przydatne funkcje: is_zero(), degree() (stopień wielomianu).
=============================================================
"""

import unittest
import numbers


class Wielomian:

    
    def __init__(self, a):

        if isinstance(a, Wielomian):
            self.a = a.a[:]

        elif isinstance(a, (int, float)):
            self.a = [a]

        elif isinstance(a, list):
            for elem in a:
                if not isinstance(elem, numbers.Number):
                    raise ValueError("Elementy listy muszą być liczbami")
            self.a = list(a)

        else:
            raise TypeError("Niepoprawny typ danych")

        self._normalize()

    def _normalize(self):
        # usuwa zera z końca listy
        while len(self.a) > 1 and abs(self.a[-1]) == 0:
            self.a.pop()
        self.size = len(self.a) - 1
                    
    
    def __add__(self, other):
        
        other = Wielomian(other)

        max_len = max(len(self.a), len(other.a))
        suma = [0] * max_len

        for i in range(max_len):
            a = self.a[i] if i < len(self.a) else 0
            b = other.a[i] if i < len(other.a) else 0
            suma[i] = a + b

        return Wielomian(suma)
    
    def __sub__(self, other):

        other = Wielomian(other)

        max_len = max(len(self.a), len(other.a))
        roznica = [0] * max_len

        for i in range(max_len):
            a = self.a[i] if i < len(self.a) else 0
            b = other.a[i] if i < len(other.a) else 0
            roznica[i] = a - b

        return Wielomian(roznica)
        
        

    def __mul__(self, other):
        
        other = Wielomian(other)

        iloczyn = [0] * (len(self.a) + len(other.a) - 1)

        for i in range(len(self.a)):
            for j in range(len(other.a)):
                iloczyn[i + j] += self.a[i] * other.a[j]

        return Wielomian(iloczyn)


        



    

    def degree(self):
        
        return self.size



    def is_zero(self):
        self._normalize()
        return len(self.a) == 1 and self.a[0] == 0



    def __getitem__(self, index):
        if not isinstance(index, int):
            raise TypeError("Indeks musi być liczbą całkowitą")

        if index < 0:
            raise IndexError("Potęga nie może być ujemna")

        if index >= len(self.a):
            return 0

        return self.a[index]




    def __call__(self, x):
        if not isinstance(x, (int, float)):
            raise TypeError("Argument musi być liczbą")

        wynik = 0
        for coef in reversed(self.a):               # x(x(xa3​+a2​)+a1​)+a0​ zamiast kalsycznego a3​x^3 + a2​x^2 + a1​x +a0​
            wynik = wynik * x + coef

        return round(float(wynik), 6)




    def __eq__(self, other):
        if not isinstance(other, Wielomian):
            return False

        self._normalize()
        other._normalize()

        return self.a == other.a


    def __ne__(self, other):
        return not self.__eq__(other)



    def __str__(self):
        self._normalize()

        if self.is_zero():      # Pomijamy zera
            return "0"

        wyrazy = []

        for i in range(len(self.a) - 1, -1, -1):
            coef = self.a[i]

            if coef == 0:
                continue

            if i == 0:
                wyrazy.append(f"{coef}")
            elif i == 1:
                if coef == 1:
                    wyrazy.append("x")
                elif coef == -1:
                    wyrazy.append("-x")
                else:
                    wyrazy.append(f"{coef}x")
            else:
                if coef == 1:
                    wyrazy.append(f"x^{i}")
                elif coef == -1:
                    wyrazy.append(f"-x^{i}")
                else:
                    wyrazy.append(f"{coef}x^{i}")

        return " + ".join(wyrazy).replace("+ -", "- ")

    """ Dodawanie, odejmowanie oraz mnożenie przez skalary """
    def __radd__(self, other):
        return self + other

    def __rsub__(self, other):
        return Wielomian(other) - self

    def __rmul__(self, other):
        return self * other



""" Testy """

class TestWielomian(unittest.TestCase):


    def test_init_valid(self):
        w = Wielomian([1, 2, 3])
        self.assertEqual(w.a, [1, 2, 3])

    def test_init_invalid_type(self):
        with self.assertRaises(TypeError):
            Wielomian("123")

    def test_init_invalid_element(self):
        with self.assertRaises(ValueError):
            Wielomian([1, "x", 3])



    def test_add(self):
        w1 = Wielomian([1, 2])
        w2 = Wielomian([3, 4])
        wynik = w1 + w2
        self.assertEqual(wynik, Wielomian([4, 6]))



    def test_sub(self):
        w1 = Wielomian([5, 4])
        w2 = Wielomian([3, 2])
        wynik = w1 - w2
        self.assertEqual(wynik, Wielomian([2, 2]))



    def test_mul(self):
        w1 = Wielomian([1, 1])       # 1 + x
        w2 = Wielomian([1, 1])       # 1 + x
        wynik = w1 * w2              # (1+x)^2 = 1 + 2x + x^2
        self.assertEqual(wynik, Wielomian([1, 2, 1]))


    def test_degree(self):
        w = Wielomian([1, 2, 0, 0])
        self.assertEqual(w.degree(), 1)



    def test_is_zero(self):
        w = Wielomian([0, 0, 0])
        self.assertTrue(w.is_zero())

        w2 = Wielomian([1, 0])
        self.assertFalse(w2.is_zero())


    def test_getitem(self):
        w = Wielomian([1, 2, 3])
        self.assertEqual(w[0], 1)
        self.assertEqual(w[2], 3)
        self.assertEqual(w[5], 0)

    def test_getitem_invalid(self):
        w = Wielomian([1, 2])
        with self.assertRaises(TypeError):
            _ = w["x"]

        with self.assertRaises(IndexError):
            _ = w[-1]


    def test_call(self):
        w = Wielomian([1, 2, 3])  
        self.assertEqual(w(0), 1)
        self.assertEqual(w(1), 6)
        self.assertEqual(w(2), 17)


    def test_eq(self):
        w1 = Wielomian([1, 2, 0])
        w2 = Wielomian([1, 2])
        self.assertTrue(w1 == w2)

    def test_ne(self):
        w1 = Wielomian([1, 2])
        w2 = Wielomian([2, 1])
        self.assertTrue(w1 != w2)


    def test_str(self):
        w = Wielomian([1, 2, 4])
        self.assertEqual(str(w), "4x^2 + 2x + 1")

        w2 = Wielomian([0])
        self.assertEqual(str(w2), "0")

    def test_radd(self):
        w = Wielomian([1, 2])
        self.assertEqual(5 + w, Wielomian([6, 2]))

    def test_rsub(self):
        w = Wielomian([1, 2])
        self.assertEqual(5 - w, Wielomian([4, -2]))

    def test_rmul(self):
        w = Wielomian([1, 2])
        self.assertEqual(3 * w, Wielomian([3, 6]))




if __name__ == "__main__":
    unittest.main()


